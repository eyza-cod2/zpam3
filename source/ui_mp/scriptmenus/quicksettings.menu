#include "ui_mp/menudef.h"
#include "ui_mp/macros.h"

#define ORIGIN_QUICKMESSAGETAB			32 224
#define ORIGIN_QUICKMESSAGEWINDOW		32 256

{
	menuDef
	{
		name			"quicksettings"
		fullscreen		0
		rect			0 0 640 480
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
 		style			WINDOW_STYLE_EMPTY

		onOpen
		{
			setDvar cl_bypassMouseInput "1"
		}
		onClose
		{
			setDvar cl_bypassMouseInput "0"
		}

// WINDOW BACKGROUND
		itemDef
		{
			name			"window_background"
			visible			1
			rect			0 0 224 192
			origin			ORIGIN_QUICKMESSAGEWINDOW
	 		style			WINDOW_STYLE_FILLED
			forecolor		1 1 1 1
			backcolor		0 0 0 0.7975
			decoration
		}

// WINDOW LINES
		itemDef
		{
			name			"window_lines"
			visible			1
			rect			3 0 2 187
			origin			ORIGIN_QUICKMESSAGEWINDOW
			style			WINDOW_STYLE_FILLED
			backcolor		1 1 1 .125
			decoration
		}
		itemDef
		{
			name			"window_lines"
			visible			1
			rect			219 0 2 187
			origin			ORIGIN_QUICKMESSAGEWINDOW
			style			WINDOW_STYLE_FILLED
			backcolor		1 1 1 .125
			decoration
		}
		itemDef
		{
			name			"window_lines"
			visible			1
			rect			5 0 214 2
			origin			ORIGIN_QUICKMESSAGEWINDOW
			style			WINDOW_STYLE_FILLED
			backcolor		1 1 1 .125
			decoration
		}
		itemDef
		{
			name			"window_lines"
			visible			1
			rect			3 187 218 2
			origin			ORIGIN_QUICKMESSAGEWINDOW
			style			WINDOW_STYLE_FILLED
			backcolor		1 1 1 .125
			decoration
		}

// TITLE
		itemDef
		{
			name			"title"
			visible			1
			rect			0 0 224 32
			origin			ORIGIN_QUICKMESSAGETAB
			style			WINDOW_STYLE_FILLED
			forecolor		1 1 1 1
			backcolor		0 0 0 0.7975
			type			ITEM_TYPE_TEXT
			text			"zPAM settings"
			textfont		UI_FONT_NORMAL
			textscale		.24
			textalignx		112
			textaligny		24
			textalign		ITEM_ALIGN_CENTER
			decoration
		}
		itemDef
		{
			name			"title_quickmessage_gray"
			visible			1
			rect			3 3 218 29
			origin			ORIGIN_QUICKMESSAGETAB
			style			WINDOW_STYLE_FILLED
			backcolor		1 1 1 .125
			decoration
		}

		QUICKMESSAGE_LINE_TEXT_DVAR(20, "1. Show match info on top: ^5Yes", 1 1 1 1, "ui_quicksettings_matchinfo", showDvar { "1" })
		QUICKMESSAGE_LINE_TEXT_DVAR(20, "1. Show match info on top: ^5No", 1 1 1 1, "ui_quicksettings_matchinfo", showDvar { "0" })
		execKey "1" { exec "openscriptmenu quicksettings matchinfo" }

		QUICKMESSAGE_LINE_TEXT_DVAR(35, "2. Show score during round: ^5Yes", 1 1 1 1, "ui_quicksettings_score", showDvar { "1" })
		QUICKMESSAGE_LINE_TEXT_DVAR(35, "2. Show score during round: ^5No", 1 1 1 1, "ui_quicksettings_score", showDvar { "0" })
		execKey "2" { exec "openscriptmenu quicksettings score" }

		QUICKMESSAGE_LINE_TEXT_DVAR(50, "3. Hit indicator: ^5Old style", 1 1 1 1, "ui_quicksettings_hitindicator", showDvar { "0" })
		QUICKMESSAGE_LINE_TEXT_DVAR(50, "3. Hit indicator: ^5New with animation", 1 1 1 1, "ui_quicksettings_hitindicator", showDvar { "1" })
		execKey "3" { exec "openscriptmenu quicksettings hitindicator" }




		QUICKMESSAGE_LINE_TEXT(167, "@QUICKMESSAGE_ESC_EXIT", 1 1 1 1)
	}
}
